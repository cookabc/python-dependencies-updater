{
    "name": "python-dependencies-updater",
    "displayName": "Python Dependencies Updater",
    "description": "Smart version management for requirements.txt and pyproject.toml with one-click updates and known-vulnerability checks",
    "version": "1.6.0",
    "publisher": "cookabc",
    "license": "MIT",
    "icon": "icon.png",
    "homepage": "https://github.com/cookabc/python-dependencies-updater#readme",
    "repository": {
        "type": "git",
        "url": "https://github.com/cookabc/python-dependencies-updater"
    },
    "bugs": {
        "url": "https://github.com/cookabc/python-dependencies-updater/issues"
    },
    "galleryBanner": {
        "color": "#1e1e1e",
        "theme": "dark"
    },
    "engines": {
        "node": ">=22.0.0",
        "vscode": "^1.85.0"
    },
    "categories": [
        "Programming Languages",
        "Other"
    ],
    "keywords": [
        "python",
        "requirements",
        "pip",
        "dependencies",
        "version",
        "update",
        "package",
        "manager",
        "upgrade"
    ],
    "activationEvents": [
        "workspaceContains:requirements.txt",
        "workspaceContains:pyproject.toml"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "colors": [
            {
                "id": "pyDepsHint.upToDate",
                "description": "%colors.upToDate%",
                "defaults": {
                    "dark": "#4CAF50",
                    "light": "#2E7D32",
                    "highContrast": "#00FF00"
                }
            },
            {
                "id": "pyDepsHint.updateAvailable",
                "description": "%colors.updateAvailable%",
                "defaults": {
                    "dark": "#FF9800",
                    "light": "#F57C00",
                    "highContrast": "#FFFF00"
                }
            }
        ],
        "commands": [
            {
                "command": "pyDepsHint.updateVersion",
                "title": "%command.updateVersion%"
            },
            {
                "command": "pyDepsHint.updateAllVersions",
                "title": "%command.updateAllVersions%"
            },
            {
                "command": "pyDepsHint.showUpToDate",
                "title": "%command.showUpToDate%"
            },
            {
                "command": "pyDepsHint.openOnPyPI",
                "title": "%command.openOnPyPI%"
            },
            {
                "command": "pyDepsHint.showVulnerabilities",
                "title": "%command.showVulnerabilities%"
            },
            {
                "command": "pyDepsHint.setRegistryToken",
                "title": "%command.setRegistryToken%"
            },
            {
                "command": "pyDepsHint._uatVulnerabilityLenses",
                "title": "UAT: read vulnerability lenses"
            },
            {
                "command": "pyDepsHint.dependencyReport",
                "title": "%command.dependencyReport%"
            },
            {
                "command": "pyDepsHint.previewAndValidate",
                "title": "%command.previewAndValidate%"
            }
        ],
        "configuration": {
            "title": "%config.title%",
            "properties": {
                "pyDepsHint.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.enabled.description%"
                },
                "pyDepsHint.showPrerelease": {
                    "type": "boolean",
                    "default": false,
                    "description": "%config.showPrerelease.description%"
                },
                "pyDepsHint.cacheTTLMinutes": {
                    "type": "number",
                    "default": 60,
                    "description": "%config.cacheTTLMinutes.description%"
                },
                "pyDepsHint.supportPyProject": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.supportPyProject.description%"
                },
                "pyDepsHint.registryUrl": {
                    "type": "string",
                    "default": "https://pypi.org",
                    "description": "%config.registryUrl.description%"
                },
                "pyDepsHint.checkVulnerabilities": {
                    "type": "boolean",
                    "default": true,
                    "description": "%config.checkVulnerabilities.description%"
                },
                "pyDepsHint.strategy": {
                    "type": "string",
                    "enum": [
                        "latest",
                        "compatible",
                        "patch"
                    ],
                    "default": "latest",
                    "description": "%config.strategy.description%"
                },
                "pyDepsHint.minimumReleaseAgeDays": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 3650,
                    "default": 0,
                    "description": "%config.minimumReleaseAgeDays.description%"
                },
                "pyDepsHint.ignoredVersions": {
                    "type": "object",
                    "default": {},
                    "additionalProperties": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "description": "%config.ignoredVersions.description%"
                },
                "pyDepsHint.deferredPackages": {
                    "type": "object",
                    "default": {},
                    "additionalProperties": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "description": "%config.deferredPackages.description%"
                },
                "pyDepsHint.targetPythonVersion": {
                    "type": "string",
                    "default": "",
                    "description": "%config.targetPythonVersion.description%",
                    "pattern": "^$|^[0-9]+\\.[0-9]+\\.[0-9]+$"
                },
                "pyDepsHint.validationCommands": {
                    "type": "array",
                    "default": [],
                    "items": {
                        "type": "object",
                        "required": [
                            "executable",
                            "args"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "executable": {
                                "type": "string",
                                "minLength": 1
                            },
                            "args": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "description": "%config.validationCommands.description%"
                }
            }
        },
        "languages": [
            {
                "id": "pip-requirements",
                "aliases": [
                    "pip requirements",
                    "requirements.txt"
                ],
                "filenames": [
                    "requirements.txt",
                    "requirements-dev.txt",
                    "requirements-test.txt",
                    "requirements-prod.txt"
                ],
                "configuration": "./language-configuration.json"
            },
            {
                "id": "toml",
                "aliases": [
                    "pyproject.toml"
                ],
                "filenames": [
                    "pyproject.toml"
                ],
                "configuration": "./language-configuration.json"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run esbuild-base -- --production",
        "esbuild-base": "node esbuild.js",
        "esbuild": "npm run esbuild-base -- --sourcemap",
        "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile",
        "test": "mocha 'out/test/unit/**/*.test.js'",
        "format": "biome format --write src",
        "lint": "biome check src",
        "publish:vsx": "./publish.sh vsx",
        "publish:ovsx": "./publish.sh ovsx",
        "publish:all": "./publish.sh all",
        "prepare": "husky",
        "uat": "npm run compile && node esbuild.js && node scripts/uat.mjs",
        "lint:fix": "biome check --write src",
        "check": "npm run check:shared && npm run lint && npm test",
        "check:shared": "node scripts/sync-shared.mjs"
    },
    "dependencies": {
        "@iarna/toml": "^2.2.5"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.4",
        "@types/chai": "^5.2.3",
        "@types/mocha": "^10.0.10",
        "@types/node": "^26.6.6",
        "@types/vscode": "1.85.0",
        "@vscode/test-electron": "^3.1.0",
        "chai": "^6.3.0",
        "esbuild": "^0.28.2",
        "fast-check": "^4.10.2",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "mocha": "^12.0.3",
        "ts-node": "^10.9.2",
        "typescript": "^7.0.2"
    },
    "lint-staged": {
        "*.ts": [
            "npx @biomejs/biome check --write --no-errors-on-unmatched"
        ]
    },
    "allowScripts": {
        "esbuild@0.28.2": true
    }
}
