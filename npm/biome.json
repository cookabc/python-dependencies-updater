{
	"$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedVariables": {
					"level": "warn",
					"options": { "ignoreRestSiblings": true }
				},
				"noUnusedImports": "warn"
			},
			"style": {
				"useConst": "warn"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always"
		}
	},
	"files": {
		"includes": ["src/**"],
		"ignoreUnknown": true
	}
}
